/test-data/

# Optional Python venv for the real hf CLI integration test (pipenv;
# in-project if PIPENV_VENV_IN_PROJECT=1 or a .venv marker is present)
.venv/

# Local environment overrides (e.g. PIPENV_PYPI_MIRROR for a private index
# mirror); see .env.example for the supported keys.
.env

# Rendered HTML docs (generated by `make docs-serve`; docs/godoc/*.md is
# committed source, docs/build/ is a disposable build artifact)
/docs/build/
/docs/godoc/*.html


